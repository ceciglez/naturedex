                {
                  "type": "text",
                  "id": "gGDQJ",
                  "name": "Math",
                  "fill": "#14180F",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "COVERAGE  ·  12 iconic taxa × 2–6 family silhouettes = 46 base sprites.  Each carries 4 remappable palette slots, 3 pattern masks and 3 size tiers → 36 species skins per silhouette, ≈ 1,650 distinct creatures from 46 hand-drawn assets. Unmatched taxa fall back to the next rank up, so a species with no skin still shows a correct family silhouette.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "bold"
                }
              ]
            },
            {
              "type": "frame",
              "id": "o1jUX",
              "x": 1579,
              "y": 1992,
              "name": "07 · 1-Bit Mode",
              "width": 1240,
              "fill": "#FFFFFF",
              "stroke": "#C9BFA6",
              "strokeWidth": 2,
              "layout": "vertical",
              "gap": 28,
              "padding": 48,
              "children": [
                {
                  "type": "text",
                  "id": "j1xiq",
                  "name": "Title",
                  "fill": "#14180F",
                  "content": "1-BIT MODE",
                  "fontFamily": "$font-display",
                  "fontSize": 22,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Bkqsl",
                  "name": "Sub",
                  "fill": "#2E3A24",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A `tone` theme axis swaps every colour token. Two values only — paper #DDEDD5 and ink #452435. Apparent mid-tones come from dither patterns, never from grey.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "Xdh9L",
                  "name": "Palette",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 14,
                  "children": [
                    {
                      "type": "text",
                      "id": "oi91K",
                      "name": "H",
                      "fill": "#4C6B33",
                      "content": "TWO VALUES · NO GREY",
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal",
                      "letterSpacing": 2
